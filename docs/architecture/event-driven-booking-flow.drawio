        <mxCell id="t-smtp" value="e-mail + presigned link" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#545B64;labelBackgroundColor=none;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1240" y="470" width="160" height="16" as="geometry" /></mxCell>
