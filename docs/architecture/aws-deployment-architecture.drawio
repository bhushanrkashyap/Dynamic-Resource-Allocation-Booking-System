        <mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1072" y="854" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="316" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="912" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-9" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="700" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-10" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="850" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;fillStyle=auto;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1880" y="30" width="650" height="1320" as="geometry" /></mxCell>
        <mxCell id="legend-container" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="1"><mxGeometry x="1900" y="60" width="602" height="1280" as="geometry" /></mxCell>
        <mxCell id="step-1-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="0" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-1-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-1-desc-legend" value='&lt;div&gt;&lt;b&gt;Ingress&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;Users reach the internet-facing Application Load Balancer over HTTPS through the VPC internet gateway.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-1-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-2-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="114" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-2-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-2-desc-legend" value='&lt;div&gt;&lt;b&gt;Path-based routing&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;ALB listener rules forward &lt;code&gt;/&lt;/code&gt; to the React/Nginx frontend and &lt;code&gt;/auth&lt;/code&gt;, &lt;code&gt;/api/trains&lt;/code&gt;, &lt;code&gt;/booking&lt;/code&gt;, &lt;code&gt;/api/payments&lt;/code&gt; to the matching Fargate service target group.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-2-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-3-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="228" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-3-desc-legend" value='&lt;div&gt;&lt;b&gt;Search and caching&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;booking-service queries the Elasticsearch train index and uses ElastiCache for station-suggestion caching (24 h TTL), 5-minute seat holds and rate limiting.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-3-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-4-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="342" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-4-desc-legend" value='&lt;div&gt;&lt;b&gt;Session security&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;auth-service issues JWT access/refresh tokens and keeps token revocation lists and login rate-limit counters in ElastiCache (TLS).&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-4-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-5-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="456" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-5-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-5-desc-legend" value='&lt;div&gt;&lt;b&gt;Event streaming&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;Services publish and consume domain events (booking-events, payment-events, payment.success, payment.failed) on Amazon MSK Serverless with IAM authentication.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-5-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-6-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="570" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-6-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-6-desc-legend" value='&lt;div&gt;&lt;b&gt;Persistence&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;Each service owns its own PostgreSQL database (auth, booking, payment, notification) on Amazon RDS, migrated with Flyway and accessed over TLS.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-6-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-7-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="684" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-7-badge-legend" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-7-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-7-desc-legend" value='&lt;div&gt;&lt;b&gt;Ticket storage&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;notification-service renders the e-ticket PDF, stores it in Amazon S3 and shares it via a time-limited presigned URL.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-7-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-8-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="798" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-8-badge-legend" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-8-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-8-desc-legend" value='&lt;div&gt;&lt;b&gt;Egress&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;Outbound calls to Razorpay, SMTP and Google token verification leave the private subnets through the NAT gateway.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-8-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-9-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="912" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-9-badge-legend" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-9-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-9-desc-legend" value='&lt;div&gt;&lt;b&gt;Image delivery&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;ECS pulls the five service images from Amazon ECR when tasks start or are redeployed.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-9-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="step-10-legend" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="legend-container"><mxGeometry y="1026" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="step-10-badge-legend" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;glass=0;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="step-10-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="step-10-desc-legend" value='&lt;div&gt;&lt;b&gt;Secret injection&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;&lt;b&gt;&lt;font style="font-size: 15px;"&gt;-&lt;/font&gt; &lt;/b&gt;Database credentials, the JWT signing key, SMTP and Razorpay secrets are injected into task definitions from AWS Secrets Manager.&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="step-10-legend"><mxGeometry x="52" y="0" width="548" height="104" as="geometry" /></mxCell>
        <mxCell id="legend-note" value="&lt;i&gt;CloudWatch (container logs; ALB, RDS and ElastiCache metrics) and IAM (task execution and task roles) are auxiliary services and carry no step number.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontColor=light-dark(#333333,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="legend-container"><mxGeometry x="0" y="1140" width="600" height="104" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
